docs/3D Models/*
!docs/3D Models/Project/
docs/3D Models/Project/*.blend1
docs/3D Models/Project/assets/
docs/3D Models/Project/renders/*/
docs/3D Models/Project/renders/*.txt
docs/3D Models/Project/renders/*.mp4

