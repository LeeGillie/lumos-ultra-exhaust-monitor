<Window x:Class="LumosAir.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LumosAir.Desktop.ViewModels"
        xmlns:ctl="clr-namespace:LumosAir.Desktop.Controls"
        Title="LumosAir – exhaust airflow monitor" Height="820" Width="1400" MinWidth="1000" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{Binding OverallColor}" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
            <TextBlock Text="{Binding OverallText}" FontWeight="Bold" Foreground="#101316"/>
          </Border>
          <StackPanel>
            <TextBlock Text="{Binding SystemName}" FontSize="15" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemName}"/>
            <TextBlock Text="{Binding AirText}" Style="{StaticResource Caption}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Material" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="190" Margin="0,0,12,0"/>
          <TextBlock Text="Source" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" Width="100" IsEnabled="{Binding IsConnected, Converter={x:Static ctl:Not.Instance}}"/>
          <TextBox Text="{Binding MqttHost, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="6,0,0,0"
                   Visibility="{Binding IsMqtt, Converter={StaticResource BoolVis}}" ToolTip="MQTT broker host"/>
          <Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}" Margin="8,0,0,0" MinWidth="90"/>
          <Button Content="Capture baseline" Command="{Binding CaptureBaselineCommand}"
                  ToolTip="With a clean duct and your normal fan level, record the current readings as 'healthy'."/>
          <Button Content="Zero sensors" Command="{Binding ZeroCommand}" ToolTip="Fan off first. Removes sensor offset."/>
          <Button Content="Edit config" Command="{Binding OpenConfigCommand}"/>
          <Button Content="Reload" Command="{Binding ReloadConfigCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="460"/>
      </Grid.ColumnDefinitions>

      <!-- Duct path -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="AIR PATH  (laser → outside)" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Segments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SegmentRow}">
                  <Border BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" Padding="8,4" Margin="0,0,0,6" Background="#232931">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VelocityText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MinText}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                      </DockPanel>
                      <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Fill, Mode=OneWay}"
                                   Foreground="{Binding Color}" Background="#2C333C" BorderThickness="0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- KPIs + trend -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="AIRFLOW" Style="{StaticResource Caption}"/>
              <TextBlock Text="{Binding FlowText}" FontSize="44" FontWeight="Light"/>
              <TextBlock Text="{Binding FlowSource}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="CYCLONE INLET" Style="{StaticResource Caption}"/>
              <TextBlock Text="{Binding CycloneText}" FontSize="32" FontWeight="Light" Margin="0,6,0,4"/>
              <TextBlock Text="{Binding CycloneDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="FAN" Style="{StaticResource Caption}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Set level" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding FanLevels}" SelectedItem="{Binding ManualFanLevel}" Width="60"
                          ToolTip="Match the level shown on the CLOUDLINE controller"/>
              </StackPanel>
              <TextBlock Text="{Binding FanText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Recommended: " Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RecommendText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Control" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding FanModes}" SelectedItem="{Binding FanMode}" Width="90"
                          ToolTip="Auto sends the level to the fan node. Manual leaves you in charge."/>
              </StackPanel>
              <TextBlock Text="{Binding FanReason}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <ctl:TrendChart x:Name="Trend"/>
        </Border>
      </Grid>

      <!-- Findings + sensors -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="WHAT TO DO" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <Grid>
              <TextBlock Text="No issues detected." Foreground="{StaticResource Muted}" Margin="4">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Findings.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Findings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingRow}">
                      <Border BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" Background="#232931" Padding="10,6" Margin="0,0,0,8">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SeverityText}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                          <TextBlock Text="{Binding Action}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="SENSORS  (Pa)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Text="reading" Style="{StaticResource Caption}" TextAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="expected" Style="{StaticResource Caption}" TextAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="drift" Style="{StaticResource Caption}" TextAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="CFM" Style="{StaticResource Caption}" TextAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChannelRow}">
                  <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Reading}" TextAlignment="Right" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="2" Text="{Binding Model}" TextAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Drift}" TextAlignment="Right" FontFamily="Consolas" Foreground="{Binding DriftColor}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Flow}" TextAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource Muted}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding BaselineText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Clear baseline" Command="{Binding ClearBaselineCommand}" Margin="0,0,4,0"/>
              <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Simulator fault injection -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding IsSimulator, Converter={StaticResource BoolVis}}">
      <StackPanel>
        <TextBlock Text="SIMULATOR – inject faults to see how the monitor reacts (capture a baseline first)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
        <WrapPanel>
          <StackPanel Width="190" Margin="0,0,16,0">
            <TextBlock Text="{Binding SimRun, StringFormat=Long run resistance ×{0:0.00}}"/>
            <Slider Minimum="0.3" Maximum="3" Value="{Binding SimRun}" ToolTip="&gt;1 clog/kink, &lt;1 leak"/>
          </StackPanel>
          <StackPanel Width="190" Margin="0,0,16,0">
            <TextBlock Text="{Binding SimCyclone, StringFormat=Cyclone resistance ×{0:0.00}}"/>
            <Slider Minimum="0.5" Maximum="3" Value="{Binding SimCyclone}"/>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,16,0">
            <TextBlock Text="{Binding SimBin, StringFormat=Bin leak {0:P0}}"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding SimBin}"/>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,16,0">
            <TextBlock Text="{Binding SimPitot, StringFormat=Pitot clog {0:P0}}"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding SimPitot}"/>
          </StackPanel>
          <StackPanel Width="170" Margin="0,0,16,0">
            <TextBlock Text="{Binding SimOutlet, StringFormat=Outlet blockage +{0:0} K}"/>
            <Slider Minimum="0" Maximum="40" Value="{Binding SimOutlet}"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <CheckBox Content="Laser lid open" IsChecked="{Binding SimLid}"/>
            <CheckBox Content="Fan node offline" IsChecked="{Binding SimFanOffline}" Margin="0,4,0,0"/>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="10,4">
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/>
    </Border>
  </Grid>
</Window>
