<Application x:Class="LumosAir.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#15181D"/>
    <SolidColorBrush x:Key="Panel" Color="#1E232A"/>
    <SolidColorBrush x:Key="PanelEdge" Color="#2C333C"/>
    <SolidColorBrush x:Key="Text" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="Muted" Color="#8B95A1"/>
    <SolidColorBrush x:Key="Accent" Color="#4FA3E0"/>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="6"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A313A"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="#3A434E"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
    <!-- Default Windows combo/text boxes draw a light background, so keep their text dark. -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111418"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#111418"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
  </Application.Resources>
</Application>
